generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String        @id @default(cuid())
  title       String
  company     String
  location    String
  type        String
  category    String?
  salaryMin   Int?
  salaryMax   Int?
  description String
  postedAt    DateTime      @default(now())
  recruiterId String
  applications Application[]
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  jobId       String
  coverLetter String?
  status      String   @default("pending")
  appliedAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}