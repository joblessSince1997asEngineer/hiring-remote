generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String        @id @default(cuid())
  title       String
  company     String
  location    String
  type        String
  category    String?
  salaryMin   Int?
  salaryMax   Int?
  description String
  postedAt    DateTime      @default(now())
  recruiterId String
  seniority            String?
  remoteType           String?
  currency             String    @default("USD")
  salaryPeriod         String    @default("year")
  skills               String[]  @default([])
  responsibilities     String?
  requirements         String?
  niceToHave           String?
  applicationDeadline  DateTime?
  status               String    @default("published")
  applications Application[]
  interviews  Interview[]
  assignments  Job_Assignments[]
  savedBy     SavedJob[]
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  jobId       String
  coverLetter String?
  cv_url        String?
  formData    Json?
  status      String   @default("pending")
  feedback    String?
  placement_fee Int?
  appliedAt   DateTime @default(now())
    hirePlan        String?
  hireNotes       String?
  hireRequestedAt DateTime?
  source          String   @default("self_applied")


  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoice     Invoice?
}

model Profiles {
  id             String   @id @default(cuid())
  full_name      String?
  primary_skill  String?
  years_exp      Int?
  expected_salary Int?
  timezone       String?
  cv_url         String?
  created_at     DateTime @default(now())
  assignments    Job_Assignments[]
}





model Roles {
  user_id                String  @id
  role                   String  @default("candidate")
  allowRecruiterSchedule Boolean @default(false)
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("candidate")
  createdAt DateTime @default(now())
  notifications  Notification[]
  subscription   Subscription?
  candidateProfile  CandidateProfile?
}
model Job_Assignments {
  id           String   @id @default(cuid())
  job_id       String
  candidate_id String
  assigned_at  DateTime @default(now())
   // Add the relation to connect it to the Job model
  job          Job      @relation(fields: [job_id], references: [id])
  candidate Profiles  @relation(fields: [candidate_id], references: [id])

  @@unique([candidate_id, job_id])
}
model Client_Requests {
  id            String   @id @default(cuid())
  company_name  String
  contact_email String
  role_title    String
  tech_stack    String[]
  budget_min    Int?
  budget_max    Int?
  working_hours String?
  status        String   @default("pending_review")
  created_at    DateTime @default(now())
  contactName      String?
  companyWebsite   String?
  companySize      String?
  seniority        String?
  remoteType       String?
  location         String?
  currency         String  @default("USD")
  budgetPeriod     String  @default("month")
  urgency          String?
  requirements     String?
  userId           String?
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Interview {
  id              String    @id @default(cuid())
  applicationId   String
  jobId           String
  candidateId     String
  interviewers    Json      @default("[]")
  clientRequestedToAttend   Boolean   @default(false)  
  requestedByUserId         String?                     
  scheduledDate   DateTime?
  timeZone        String    @default("UTC")
  videoLink       String?
  clientNotes     String?
  candidateNotes  String?
  status          String    @default("pending")
  requestedBy     String    @default("admin")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                     String    @id @default(cuid())
  applicationId          String    @unique
  jobId                  String
  clientId               String
  planType               String
  baseAmount             Int
  discountPercent        Int       @default(0)
  amount                 Int
  currency               String    @default("usd")
  status                 String    @default("pending")
  dueAt                  DateTime
  remindersSent          Json      @default("[]")
  terminatedAt           DateTime?
  stripeSessionId        String?
  stripePaymentIntentId  String?
  paidAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([dueAt, status])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  tier                   String
  status                 String    @default("active")
  startedAt              DateTime  @default(now())
  expiresAt              DateTime
  firstPaymentAmount     Int       @default(5000)
  renewalAmount          Int       @default(4000)
  stripeCustomerId       String?
  stripeSessionId        String?
  renewalReminderSentAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String?
  avatarUrl       String?
  primarySkill    String?
  yearsExp        Int?
  expectedSalary  Int?
  timezone        String?
  phone           String?
  city            String?
  country         String?
  linkedinUrl     String?
  portfolioUrl    String?
  bio             String?
  cvUrl           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model ContactMessage {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  company    String?
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read, createdAt])
}
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
   job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}